{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    // DOM too: test code runs functions inside the page (page.evaluate).
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,
    // Playwright bundles the tests itself, so resolve imports like the app does.
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["e2e", "playwright.config.ts"]
}
